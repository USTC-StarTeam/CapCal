# Data root (default: data)
RERANK_BIAS_DATA_ROOT=/path/to/your/data

# HF cache (default: $RERANK_BIAS_DATA_ROOT/huggingface)
RERANK_BIAS_HF_HOME=/path/to/your/data/huggingface

# Optional: BGE reranker path or model id
RERANK_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional: msmarco_v2_passage directory for TREC DL 2021/2022/2023
RERANK_MSMARCO_V2_PASSAGE_DIR=/path/to/your/data/msmarco_v2_passage
